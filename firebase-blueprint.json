{
  "entities": {
    "Appointment": {
      "title": "Appointment",
      "description": "Patient appointment request at Dr. Waseem Allergy Clinic",
      "type": "object",
      "properties": {
        "patientName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Full name of the patient"
        },
        "phone": {
          "type": "string",
          "minLength": 8,
          "maxLength": 25,
          "description": "Contact phone or WhatsApp number"
        },
        "age": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10,
          "description": "Age of the patient"
        },
        "preferredDate": {
          "type": "string",
          "minLength": 4,
          "maxLength": 30,
          "description": "Preferred appointment date"
        },
        "problemDescription": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1000,
          "description": "Details of allergic condition or symptoms"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "confirmed", "completed", "cancelled"],
          "description": "Appointment status"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase Auth UID of applicant"
        },
        "userEmail": {
          "type": "string",
          "maxLength": 150,
          "description": "Email of applicant"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation"
        }
      },
      "required": ["patientName", "phone", "age", "preferredDate", "problemDescription", "status", "userId", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "Patient review and clinic feedback",
      "type": "object",
      "properties": {
        "authorName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100,
          "description": "Name of the reviewer"
        },
        "rating": {
          "type": "number",
          "description": "Star rating from 1 to 5"
        },
        "comment": {
          "type": "string",
          "minLength": 5,
          "maxLength": 1000,
          "description": "Review text"
        },
        "tag": {
          "type": "string",
          "maxLength": 50,
          "description": "Review tag such as 'Helpful staff' or 'Allergy clinic'"
        },
        "userId": {
          "type": "string",
          "maxLength": 128,
          "description": "Firebase Auth UID of reviewer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of creation"
        }
      },
      "required": ["authorName", "rating", "comment", "userId", "createdAt"]
    }
  },
  "firestore": {
    "/appointments/{appointmentId}": {
      "schema": {
        "$ref": "#/entities/Appointment"
      },
      "description": "Patient clinic appointments"
    },
    "/reviews/{reviewId}": {
      "schema": {
        "$ref": "#/entities/Review"
      },
      "description": "Patient feedback and reviews"
    }
  }
}
